{
  "name": "Flashcard",
  "type": "object",
  "properties": {
    "language": {
      "type": "string",
      "enum": [
        "python",
        "javascript",
        "typescript",
        "gdscript"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "front": {
      "type": "string"
    },
    "back": {
      "type": "string"
    }
  },
  "required": [
    "language",
    "front",
    "back"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}