{
  "name": "UserStat",
  "type": "object",
  "properties": {
    "current_streak": {
      "type": "number",
      "default": 0
    },
    "longest_streak": {
      "type": "number",
      "default": 0
    },
    "total_xp": {
      "type": "number",
      "default": 0
    },
    "last_lesson_date": {
      "type": "string",
      "format": "date"
    },
    "lessons_completed": {
      "type": "number",
      "default": 0
    },
    "gems": {
      "type": "number",
      "default": 10
    }
  },
  "required": [],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}